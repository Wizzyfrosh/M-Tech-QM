# Use a dedicated development database; never commit real credentials.
DATABASE_URL=postgresql://qms:qms@localhost:5432/qms_dev
# Optional direct connection for migrations if DATABASE_URL is pooled.
DIRECT_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# brevo for a deployed environment; file only for local development.
MAIL_TRANSPORT=brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=M Tech QMS
# Optional AI drafting. Configure at least one provider; keep keys server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
XAI_API_KEY=
GROK_MODEL=grok-4.3

# Private assignment attachments. Never use a public bucket or NEXT_PUBLIC keys.
QMS_UPLOAD_BUCKET=
QMS_UPLOAD_S3_ENDPOINT=
QMS_UPLOAD_S3_REGION=
QMS_UPLOAD_S3_ACCESS_KEY=
QMS_UPLOAD_S3_SECRET_KEY=
# Optional local development only: file. Refused in production.
QMS_UPLOAD_DRIVER=
# Set to 1 for a deployment preflight; reset after verification.
QMS_VERIFY_UPLOAD_STORAGE=
