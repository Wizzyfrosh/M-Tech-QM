generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
}

enum RosterStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id                String       @id
  name              String
  email             String       @unique
  emailVerified     Boolean      @default(false)
  image             String?
  role              Role         @default(STUDENT)
  leaderboardOptOut Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  sessions          Session[]
  accounts          Account[]
  roster            RosterEntry?
  auditEvents       AuditEvent[]
  quizzes           Quiz[]
  attempts          Attempt[]
  aiGenerations     AiGeneration[]
  notifications     Notification[]
  assignments       Assignment[]
  assignmentSubmissions AssignmentSubmission[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model RosterEntry {
  id              String       @id @default(uuid())
  normalizedEmail String       @unique
  name            String
  status          RosterStatus @default(PENDING)
  revision        Int          @default(0)
  userId          String?      @unique
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, createdAt])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entityId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RequestBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ReviewMode {
  AFTER_SUBMISSION
  AFTER_CLOSE
  INSTRUCTOR_RELEASE
}

model Quiz {
  id                 String     @id @default(uuid())
  shareSlug          String     @unique @default(uuid())
  title              String
  lessonLabel        String     @default("")
  description        String     @default("")
  lessonUrl          String?
  lessonUrls         String[]   @default([])
  deadline           DateTime?
  status             QuizStatus @default(DRAFT)
  revision           Int        @default(0)
  reviewMode         ReviewMode @default(INSTRUCTOR_RELEASE)
  leaderboardEnabled Boolean    @default(true)
  reviewReleasedAt   DateTime?
  publishedAt        DateTime?
  closedAt           DateTime?
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdBy          String
  creator            User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  questions          Question[]
  attempts           Attempt[]
  aiGenerations      AiGeneration[]
  resultEmails       ResultEmailBatch[]

  @@index([status, createdAt])
  @@index([createdBy, createdAt])
}

model Question {
  id          String     @id @default(uuid())
  quizId      String
  quiz        Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt      String     @default("")
  explanation String     @default("")
  marks       Int        @default(1)
  position    Int
  reviewedAt  DateTime?
  options     Option[]
  answerKey   AnswerKey?
  attemptAnswers AttemptAnswer[]

  @@unique([quizId, position])
  @@unique([id, quizId])
}

model Option {
  id         String     @id @default(uuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String     @default("")
  position   Int
  correctFor AnswerKey?

  @@unique([questionId, position])
  @@unique([questionId, id])
}

model AnswerKey {
  questionId      String   @id
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctOptionId String   @unique
  correctOption   Option   @relation(fields: [correctOptionId], references: [id], onDelete: Cascade)
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model ResultEmailBatch {
  id         String @id @default(uuid())
  quizId     String
  quiz       Quiz @relation(fields: [quizId], references: [id], onDelete: Restrict)
  recipients Json
  status     String @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([quizId])
}

model Attempt {
  id           String        @id @default(uuid())
  quizId       String
  quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Restrict)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status       AttemptStatus @default(IN_PROGRESS)
  revision     Int           @default(0)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  earnedMarks  Int?
  maxMarks     Int?
  answers      AttemptAnswer[]

  @@unique([quizId, userId])
  @@unique([id, quizId])
  @@index([quizId, status])
  @@index([userId, submittedAt])
}

model AttemptAnswer {
  attemptId        String
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizId           String
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptionId String?
  awardedMarks    Int?

  @@id([attemptId, questionId])
}

model InstructorInvitation {
  id             String    @id @default("primary")
  email          String    @unique
  name           String
  codeHash       String?
  expiresAt      DateTime?
  requestedAt    DateTime?
  failedAttempts Int       @default(0)
  redeemedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AiGeneration {
  id            String   @id @default(uuid())
  instructorId  String
  instructor    User     @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  model         String
  status        String   @default("STARTED")
  count         Int
  inputTokens   Int?
  outputTokens  Int?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([instructorId, createdAt])
  @@index([quizId, createdAt])
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey String
  kind String
  title String
  message String
  href String
  readAt DateTime?
  emailStatus String @default("PENDING")
  createdAt DateTime @default(now())
  @@unique([userId, eventKey])
  @@index([userId, createdAt])
  @@index([emailStatus, createdAt])
}


model Assignment {
  id String @id @default(uuid())
  createdBy String
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  title String @default("Untitled assignment")
  instructions String @default("")
  rubric String @default("")
  resources String[] @default([])
  submissionType String @default("PROJECT")
  maxMarks Int @default(100)
  deadline DateTime?
  allowLate Boolean @default(false)
  status String @default("DRAFT")
  revision Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submissions AssignmentSubmission[]
  @@index([createdBy, createdAt])
  @@index([status, createdAt])
}

model AssignmentSubmission {
  id String @id @default(uuid())
  assignmentId String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  status String @default("DRAFT")
  revision Int @default(0)
  responseText String @default("")
  projectUrl String @default("")
  evidenceUrls String[] @default([])
  version Int @default(0)
  submittedAt DateTime?
  late Boolean @default(false)
  grade Int?
  feedback String @default("")
  changeRequest String @default("")
  releasedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions AssignmentVersion[]
  @@unique([assignmentId, userId])
  @@index([assignmentId, status])
  @@index([userId, updatedAt])
}

model AssignmentVersion {
  id String @id @default(uuid())
  submissionId String
  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  version Int
  responseText String
  projectUrl String
  evidenceUrls String[]
  submittedAt DateTime @default(now())
  late Boolean
  @@unique([submissionId, version])
}
